  49:Middlewares/ST/filex/common/src/fx_directory_create.c **** /*                                                                        */
  50:Middlewares/ST/filex/common/src/fx_directory_create.c **** /*    This function first attempts to find the specified directory.       */
  51:Middlewares/ST/filex/common/src/fx_directory_create.c **** /*    If found, the create request is invalid and an error is returned    */
  52:Middlewares/ST/filex/common/src/fx_directory_create.c **** /*    to the caller.  After the file name verification is made, a search  */
  53:Middlewares/ST/filex/common/src/fx_directory_create.c **** /*    for a free directory entry will be made.  If nothing is available,  */
  54:Middlewares/ST/filex/common/src/fx_directory_create.c **** /*    an error will be returned to the caller.  Otherwise, if all is      */
  55:Middlewares/ST/filex/common/src/fx_directory_create.c **** /*    okay, an empty directory will be created.                           */
  56:Middlewares/ST/filex/common/src/fx_directory_create.c **** /*                                                                        */
