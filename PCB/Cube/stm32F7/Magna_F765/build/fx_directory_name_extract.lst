  46:Middlewares/ST/filex/common/src/fx_directory_name_extract.c **** /*    This function extracts the file name from the supplied input        */
  47:Middlewares/ST/filex/common/src/fx_directory_name_extract.c **** /*    string.  If there is nothing left after the extracted name, a NULL  */
  48:Middlewares/ST/filex/common/src/fx_directory_name_extract.c **** /*    is returned to the caller.  Otherwise, if something is left, a      */
  49:Middlewares/ST/filex/common/src/fx_directory_name_extract.c **** /*    pointer to it is returned.                                          */
  50:Middlewares/ST/filex/common/src/fx_directory_name_extract.c **** /*                                                                        */
