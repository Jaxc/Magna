  47:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*                                                                        */
  48:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*    This function examines the list of open files for this media and    */
  49:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*    "flushes" each written open file to the underlying media.  After    */
  50:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*    the open files have been flushed, the internal logical sector is    */
  51:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*    flushed.  Finally, the attached driver is sent a flush command so   */
  52:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*    that it can flush its sector cache (if any) to the media.           */
  53:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*                                                                        */
  54:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*  INPUT                                                                 */
  55:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*                                                                        */
  56:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*    media_ptr                             Media control block pointer   */
  57:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*                                                                        */
  58:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*  OUTPUT                                                                */
  59:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*                                                                        */
  60:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*    return status                                                       */
  61:Middlewares/ST/filex/common/src/fx_media_flush.c **** /*                                                                        */
