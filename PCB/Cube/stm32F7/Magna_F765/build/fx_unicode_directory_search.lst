  53:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*                                                                        */
  54:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*  DESCRIPTION                                                           */
  55:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*                                                                        */
  56:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    This function searches for the specified unicode or short name.     */
  57:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*                                                                        */
  58:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    Note: The buffer of short_name and unicode_name must be valid to    */
  59:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    fill search result. When short_name is a zero length string, search */
  60:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    is based on unicode string (terminated with NULL). If it's found    */
  61:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    the short name is written back to buffer of short_name. In this case*/
  62:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    unicode_name_buffer_length is ignored and short_name_buffer_length  */
  63:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    must not be zero to specify the buffer length. If buffer is too     */
  64:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    smallfor the result, overflow characters and NULL-terminator are cut*/
  65:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    off. When short_name is a valid string, search is based on          */
  66:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    short_name (terminated with NULL). If it's found the unicode name is*/
  67:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    written back to buffer of unicode_name. In this case                */
  68:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    short_name_buffer_length is ignored and unicode_name_buffer_length  */
  69:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    must not be zero to specify the unicode buffer length. If buffer is */
  70:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    too small for the result, overflow characters are cut off but       */
  71:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    NULL-terminator is kept.                                            */
  72:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*                                                                        */
  73:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*  INPUT                                                                 */
  74:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*                                                                        */
