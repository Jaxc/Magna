  80:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*    unicode_name_buffer_length            Buffer length for Unicode name*/
  81:Middlewares/ST/filex/common/src/fx_unicode_directory_search.c **** /*                                                                        */
