  48:Middlewares/ST/filex/common/src/fx_utility_logical_sector_read.c **** /*    This function handles logical sector read requests for all FileX    */
  49:Middlewares/ST/filex/common/src/fx_utility_logical_sector_read.c **** /*    components.  If the logical sector is currently in the logical      */
  50:Middlewares/ST/filex/common/src/fx_utility_logical_sector_read.c **** /*    sector cache, the function simply sets the appropriate pointer and  */
  51:Middlewares/ST/filex/common/src/fx_utility_logical_sector_read.c **** /*    returns a successful status to the caller.  Otherwise, physical I/O */
  52:Middlewares/ST/filex/common/src/fx_utility_logical_sector_read.c **** /*    is requested through the corresponding I/O driver.                  */
  53:Middlewares/ST/filex/common/src/fx_utility_logical_sector_read.c **** /*                                                                        */
  54:Middlewares/ST/filex/common/src/fx_utility_logical_sector_read.c **** /*    Note: Conversion of the logical sector is done inside the driver.   */
  55:Middlewares/ST/filex/common/src/fx_utility_logical_sector_read.c **** /*          This results in a performance boost for FLASH or RAM media    */
  56:Middlewares/ST/filex/common/src/fx_utility_logical_sector_read.c **** /*          devices.                                                      */
  57:Middlewares/ST/filex/common/src/fx_utility_logical_sector_read.c **** /*                                                                        */
