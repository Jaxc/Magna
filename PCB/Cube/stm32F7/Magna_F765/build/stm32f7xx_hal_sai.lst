 845:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** /** @defgroup SAI_Exported_Functions_Group2 IO operation functions
 846:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   * @brief    Data transfers functions
 847:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   *
 848:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** @verbatim
 849:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   ==============================================================================
 850:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****                       ##### IO operation functions #####
 851:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   ==============================================================================
 852:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   [..]
 853:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     This subsection provides a set of functions allowing to manage the SAI data
 854:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     transfers.
 855:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** 
 856:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     (+) There are two modes of transfer:
 857:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       (++) Blocking mode : The communication is performed in the polling mode.
 858:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****            The status of all data processing is returned by the same function
 859:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****            after finishing transfer.
 860:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       (++) No-Blocking mode : The communication is performed using Interrupts
 861:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****            or DMA. These functions return the status of the transfer startup.
 862:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****            The end of the data processing will be indicated through the
 863:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****            dedicated SAI IRQ when using Interrupt mode or the DMA IRQ when
 864:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****            using DMA mode.
 865:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** 
 866:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     (+) Blocking mode functions are :
 867:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       (++) HAL_SAI_Transmit()
 868:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       (++) HAL_SAI_Receive()
 869:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** 
 870:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     (+) Non Blocking mode functions with Interrupt are :
 871:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       (++) HAL_SAI_Transmit_IT()
 872:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       (++) HAL_SAI_Receive_IT()
 873:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** 
 874:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     (+) Non Blocking mode functions with DMA are :
 875:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       (++) HAL_SAI_Transmit_DMA()
 876:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       (++) HAL_SAI_Receive_DMA()
 877:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** 
 878:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     (+) A set of Transfer Complete Callbacks are provided in non Blocking mode:
 879:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       (++) HAL_SAI_TxCpltCallback()
 880:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       (++) HAL_SAI_RxCpltCallback()
 881:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       (++) HAL_SAI_ErrorCallback()
 882:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** 
 883:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** @endverbatim
 884:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   * @{
 885:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   */
 886:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** 
ARM GAS  /tmp/cc7jkpta.s 			page 17


