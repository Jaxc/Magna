 490:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   {
 491:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     uint32_t freq = 0;
 492:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     uint32_t tmpval;
