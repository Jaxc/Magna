 494:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     if ((hsai->Instance == SAI1_Block_A) || (hsai->Instance == SAI1_Block_B))
 495:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     {
 496:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       freq = HAL_RCCEx_GetPeriphCLKFreq(RCC_PERIPHCLK_SAI1);
 497:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     }
 498:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     if ((hsai->Instance == SAI2_Block_A) || (hsai->Instance == SAI2_Block_B))
 499:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     {
 500:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       freq = HAL_RCCEx_GetPeriphCLKFreq(RCC_PERIPHCLK_SAI2);
 501:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     }
 502:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** 
 503:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     /* Configure Master Clock using the following formula :
 504:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****        MCLK_x = SAI_CK_x / (MCKDIV[3:0] * 2) with MCLK_x = 256 * FS
 505:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****        FS = SAI_CK_x / (MCKDIV[3:0] * 2) * 256
 506:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****        MCKDIV[3:0] = SAI_CK_x / FS * 512 */
 507:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     /* (freq x 10) to keep Significant digits */
 508:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     tmpval = (freq * 10) / (hsai->Init.AudioFrequency * 2 * 256);
 509:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     hsai->Init.Mckdiv = tmpval / 10;
 510:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** 
 511:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     /* Round result to the nearest integer */
 512:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     if ((tmpval % 10) > 8)
 513:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     {
 514:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       hsai->Init.Mckdiv += 1;
 515:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     }
 516:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** 
 517:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     /* For SPDIF protocol, SAI shall provide a bit clock twice faster the symbol-rate */
 518:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     if (hsai->Init.Protocol == SAI_SPDIF_PROTOCOL)
 519:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     {
 520:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****       hsai->Init.Mckdiv = hsai->Init.Mckdiv >> 1;
 521:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     }
 522:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   }
 523:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   /* Check the SAI Block master clock divider parameter */
 524:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   assert_param(IS_SAI_BLOCK_MASTER_DIVIDER(hsai->Init.Mckdiv));
 525:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c **** 
 526:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   /* Compute CKSTR bits of SAI CR1 according ClockStrobing and AudioMode */
 527:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   if ((hsai->Init.AudioMode == SAI_MODEMASTER_TX) || (hsai->Init.AudioMode == SAI_MODESLAVE_TX))
 528:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   {
 529:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     /* Transmit */
 530:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     ckstr_bits = (hsai->Init.ClockStrobing == SAI_CLOCKSTROBING_RISINGEDGE) ? 0 : SAI_xCR1_CKSTR;
 531:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   }
 532:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   else
 533:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   {
 534:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     /* Receive */
 535:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****     ckstr_bits = (hsai->Init.ClockStrobing == SAI_CLOCKSTROBING_RISINGEDGE) ? SAI_xCR1_CKSTR : 0;
 536:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_sai.c ****   }
