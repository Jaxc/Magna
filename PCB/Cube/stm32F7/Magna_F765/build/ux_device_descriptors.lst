 182:USBX/App/ux_device_descriptors.c **** uint8_t *USBD_Get_String_Framework(ULONG *Length)
 183:USBX/App/ux_device_descriptors.c **** {
 184:USBX/App/ux_device_descriptors.c ****   uint16_t len = 0U;
 185:USBX/App/ux_device_descriptors.c ****   uint8_t count = 0U;
 186:USBX/App/ux_device_descriptors.c **** 
 187:USBX/App/ux_device_descriptors.c ****   /* USER CODE String_Framework0 */
 188:USBX/App/ux_device_descriptors.c **** 
 189:USBX/App/ux_device_descriptors.c ****   /* USER CODE String_Framework0 */
 190:USBX/App/ux_device_descriptors.c **** 
 191:USBX/App/ux_device_descriptors.c ****   /* Set the Manufacturer language Id and index in USBD_string_framework */
 192:USBX/App/ux_device_descriptors.c ****   USBD_string_framework[count++] = USBD_LANGID_STRING & 0xFF;
 193:USBX/App/ux_device_descriptors.c ****   USBD_string_framework[count++] = USBD_LANGID_STRING >> 8;
 194:USBX/App/ux_device_descriptors.c ****   USBD_string_framework[count++] = USBD_IDX_MFC_STR;
 195:USBX/App/ux_device_descriptors.c **** 
 196:USBX/App/ux_device_descriptors.c ****   /* Set the Manufacturer string in string_framework */
 197:USBX/App/ux_device_descriptors.c ****   USBD_Desc_GetString((uint8_t *)USBD_MANUFACTURER_STRING, USBD_string_framework + count, &len);
 198:USBX/App/ux_device_descriptors.c **** 
 199:USBX/App/ux_device_descriptors.c ****   /* Set the Product language Id and index in USBD_string_framework */
 200:USBX/App/ux_device_descriptors.c ****   count += len + 1;
 201:USBX/App/ux_device_descriptors.c ****   USBD_string_framework[count++] = USBD_LANGID_STRING & 0xFF;
 202:USBX/App/ux_device_descriptors.c ****   USBD_string_framework[count++] = USBD_LANGID_STRING >> 8;
ARM GAS  /tmp/cc95weaH.s 			page 5


 203:USBX/App/ux_device_descriptors.c ****   USBD_string_framework[count++] = USBD_IDX_PRODUCT_STR;
 204:USBX/App/ux_device_descriptors.c **** 
 205:USBX/App/ux_device_descriptors.c ****   /* Set the Product string in USBD_string_framework */
 206:USBX/App/ux_device_descriptors.c ****   USBD_Desc_GetString((uint8_t *)USBD_PRODUCT_STRING, USBD_string_framework + count, &len);
 207:USBX/App/ux_device_descriptors.c **** 
 208:USBX/App/ux_device_descriptors.c ****   /* Set Serial language Id and index in string_framework */
 209:USBX/App/ux_device_descriptors.c ****   count += len + 1;
 210:USBX/App/ux_device_descriptors.c ****   USBD_string_framework[count++] = USBD_LANGID_STRING & 0xFF;
 211:USBX/App/ux_device_descriptors.c ****   USBD_string_framework[count++] = USBD_LANGID_STRING >> 8;
 212:USBX/App/ux_device_descriptors.c ****   USBD_string_framework[count++] = USBD_IDX_SERIAL_STR;
 213:USBX/App/ux_device_descriptors.c **** 
 214:USBX/App/ux_device_descriptors.c ****   /* Set the Serial number in USBD_string_framework */
 215:USBX/App/ux_device_descriptors.c ****   USBD_Desc_GetString((uint8_t *)USBD_SERIAL_NUMBER, USBD_string_framework + count, &len);
 216:USBX/App/ux_device_descriptors.c **** 
 217:USBX/App/ux_device_descriptors.c ****   /* USER CODE String_Framework1 */
 218:USBX/App/ux_device_descriptors.c **** 
 219:USBX/App/ux_device_descriptors.c ****   /* USER CODE String_Framework1 */
 220:USBX/App/ux_device_descriptors.c **** 
 221:USBX/App/ux_device_descriptors.c ****   /* Get the length of USBD_string_framework */
 222:USBX/App/ux_device_descriptors.c ****   *Length = strlen((const char *)USBD_string_framework);
