 297:USBX/App/ux_device_descriptors.c **** /**
 298:USBX/App/ux_device_descriptors.c ****   * @brief  USBD_Device_Framework_Builder
 299:USBX/App/ux_device_descriptors.c ****   *         Device Framework builder
 300:USBX/App/ux_device_descriptors.c ****   * @param  pdev: device instance
 301:USBX/App/ux_device_descriptors.c ****   * @param  pDevFrameWorkDesc: Pointer to the device framework descriptor
 302:USBX/App/ux_device_descriptors.c ****   * @param  UserClassInstance: type of the class to be added
 303:USBX/App/ux_device_descriptors.c ****   * @param  Speed: Speed parameter HS or FS
 304:USBX/App/ux_device_descriptors.c ****   * @retval status
 305:USBX/App/ux_device_descriptors.c ****   */
 306:USBX/App/ux_device_descriptors.c **** static uint8_t *USBD_Device_Framework_Builder(USBD_DevClassHandleTypeDef *pdev,
 307:USBX/App/ux_device_descriptors.c ****                                               uint8_t *pDevFrameWorkDesc,
 308:USBX/App/ux_device_descriptors.c ****                                               uint8_t *UserClassInstance,
 309:USBX/App/ux_device_descriptors.c ****                                               uint8_t Speed)
 310:USBX/App/ux_device_descriptors.c **** {
 311:USBX/App/ux_device_descriptors.c ****   static USBD_DeviceDescTypedef *pDevDesc;
 312:USBX/App/ux_device_descriptors.c ****   static USBD_DevQualiDescTypedef *pDevQualDesc;
 313:USBX/App/ux_device_descriptors.c ****   uint8_t Idx_Instance = 0U;
 314:USBX/App/ux_device_descriptors.c ****   uint8_t NumberClass = 1U;
 315:USBX/App/ux_device_descriptors.c **** 
 316:USBX/App/ux_device_descriptors.c ****   /* Set Dev and conf descriptors size to 0 */
 317:USBX/App/ux_device_descriptors.c ****   pdev->CurrConfDescSz = 0U;
 318:USBX/App/ux_device_descriptors.c ****   pdev->CurrDevDescSz = 0U;
 319:USBX/App/ux_device_descriptors.c **** 
 320:USBX/App/ux_device_descriptors.c ****   /* Set the pointer to the device descriptor area*/
 321:USBX/App/ux_device_descriptors.c ****   pDevDesc = (USBD_DeviceDescTypedef *)pDevFrameWorkDesc;
 322:USBX/App/ux_device_descriptors.c **** 
 323:USBX/App/ux_device_descriptors.c ****   /* Start building the generic device descriptor common part */
 324:USBX/App/ux_device_descriptors.c ****   pDevDesc->bLength = (uint8_t)sizeof(USBD_DeviceDescTypedef);
 325:USBX/App/ux_device_descriptors.c ****   pDevDesc->bDescriptorType = UX_DEVICE_DESCRIPTOR_ITEM;
 326:USBX/App/ux_device_descriptors.c ****   pDevDesc->bcdUSB = USB_BCDUSB;
 327:USBX/App/ux_device_descriptors.c ****   pDevDesc->bDeviceClass = 0x00;
ARM GAS  /tmp/cc95weaH.s 			page 10


 328:USBX/App/ux_device_descriptors.c ****   pDevDesc->bDeviceSubClass = 0x00;
 329:USBX/App/ux_device_descriptors.c ****   pDevDesc->bDeviceProtocol = 0x00;
 330:USBX/App/ux_device_descriptors.c ****   pDevDesc->bMaxPacketSize = USBD_MAX_EP0_SIZE;
 331:USBX/App/ux_device_descriptors.c ****   pDevDesc->idVendor = USBD_VID;
 332:USBX/App/ux_device_descriptors.c ****   pDevDesc->idProduct = USBD_PID;
 333:USBX/App/ux_device_descriptors.c ****   pDevDesc->bcdDevice = 0x0200;
 334:USBX/App/ux_device_descriptors.c ****   pDevDesc->iManufacturer = USBD_IDX_MFC_STR;
 335:USBX/App/ux_device_descriptors.c ****   pDevDesc->iProduct = USBD_IDX_PRODUCT_STR;
 336:USBX/App/ux_device_descriptors.c ****   pDevDesc->iSerialNumber = USBD_IDX_SERIAL_STR;
 337:USBX/App/ux_device_descriptors.c ****   pDevDesc->bNumConfigurations = USBD_MAX_NUM_CONFIGURATION;
 338:USBX/App/ux_device_descriptors.c ****   pdev->CurrDevDescSz += (uint32_t)sizeof(USBD_DeviceDescTypedef);
 339:USBX/App/ux_device_descriptors.c **** 
 340:USBX/App/ux_device_descriptors.c ****   /* Check if USBx is in high speed mode to add qualifier descriptor */
 341:USBX/App/ux_device_descriptors.c ****   if (Speed == USBD_HIGH_SPEED)
 342:USBX/App/ux_device_descriptors.c ****   {
 343:USBX/App/ux_device_descriptors.c ****     pDevQualDesc = (USBD_DevQualiDescTypedef *)(pDevFrameWorkDesc + pdev->CurrDevDescSz);
 344:USBX/App/ux_device_descriptors.c ****     pDevQualDesc->bLength = (uint8_t)sizeof(USBD_DevQualiDescTypedef);
 345:USBX/App/ux_device_descriptors.c ****     pDevQualDesc->bDescriptorType = UX_DEVICE_QUALIFIER_DESCRIPTOR_ITEM;
 346:USBX/App/ux_device_descriptors.c ****     pDevQualDesc->bcdDevice = 0x0200;
 347:USBX/App/ux_device_descriptors.c ****     pDevQualDesc->Class = 0x00;
 348:USBX/App/ux_device_descriptors.c ****     pDevQualDesc->SubClass = 0x00;
 349:USBX/App/ux_device_descriptors.c ****     pDevQualDesc->Protocol = 0x00;
 350:USBX/App/ux_device_descriptors.c ****     pDevQualDesc->bMaxPacketSize = 0x40;
 351:USBX/App/ux_device_descriptors.c ****     pDevQualDesc->bNumConfigurations = 0x01;
 352:USBX/App/ux_device_descriptors.c ****     pDevQualDesc->bReserved = 0x00;
 353:USBX/App/ux_device_descriptors.c ****     pdev->CurrDevDescSz += (uint32_t)sizeof(USBD_DevQualiDescTypedef);
 354:USBX/App/ux_device_descriptors.c ****   }
 355:USBX/App/ux_device_descriptors.c **** 
 356:USBX/App/ux_device_descriptors.c ****   /* Build the device framework */
 357:USBX/App/ux_device_descriptors.c ****   while (Idx_Instance < USBD_MAX_SUPPORTED_CLASS)
 358:USBX/App/ux_device_descriptors.c ****   {
 359:USBX/App/ux_device_descriptors.c ****     if ((pdev->classId < USBD_MAX_SUPPORTED_CLASS) &&
 360:USBX/App/ux_device_descriptors.c ****         (pdev->NumClasses < USBD_MAX_SUPPORTED_CLASS))
 361:USBX/App/ux_device_descriptors.c ****     {
 362:USBX/App/ux_device_descriptors.c ****       /* Call the composite class builder */
 363:USBX/App/ux_device_descriptors.c ****       (void)USBD_FrameWork_AddClass(pdev,
 364:USBX/App/ux_device_descriptors.c ****                                     (USBD_CompositeClassTypeDef)UserClassInstance[Idx_Instance],
 365:USBX/App/ux_device_descriptors.c ****                                     0, Speed, (pDevFrameWorkDesc + pdev->CurrDevDescSz));
 366:USBX/App/ux_device_descriptors.c **** 
 367:USBX/App/ux_device_descriptors.c ****       /* Increment the ClassId for the next occurrence */
 368:USBX/App/ux_device_descriptors.c ****       pdev->classId ++;
 369:USBX/App/ux_device_descriptors.c ****       pdev->NumClasses ++;
 370:USBX/App/ux_device_descriptors.c ****     }
 371:USBX/App/ux_device_descriptors.c ****     Idx_Instance++;
 372:USBX/App/ux_device_descriptors.c **** 
 373:USBX/App/ux_device_descriptors.c ****     /* Count the number of Classes different of CLASS_TYPE_NONE */
 374:USBX/App/ux_device_descriptors.c ****     if (UserClassInstance[Idx_Instance] != CLASS_TYPE_NONE)
 375:USBX/App/ux_device_descriptors.c ****     {
 376:USBX/App/ux_device_descriptors.c ****       NumberClass++;
 377:USBX/App/ux_device_descriptors.c ****     }
 378:USBX/App/ux_device_descriptors.c ****   }
 379:USBX/App/ux_device_descriptors.c ****   /* Check if there is a composite class and update device class */
 380:USBX/App/ux_device_descriptors.c ****   if (NumberClass > 1)
 381:USBX/App/ux_device_descriptors.c ****   {
 382:USBX/App/ux_device_descriptors.c ****     pDevDesc->bDeviceClass = 0xEF;
 383:USBX/App/ux_device_descriptors.c ****     pDevDesc->bDeviceSubClass = 0x02;
 384:USBX/App/ux_device_descriptors.c ****     pDevDesc->bDeviceProtocol = 0x01;
ARM GAS  /tmp/cc95weaH.s 			page 11


 385:USBX/App/ux_device_descriptors.c ****   }
 386:USBX/App/ux_device_descriptors.c ****   else
 387:USBX/App/ux_device_descriptors.c ****   {
 388:USBX/App/ux_device_descriptors.c ****     /* Check if the CDC ACM class is set and update device class */
 389:USBX/App/ux_device_descriptors.c ****     if (UserClassInstance[0] == CLASS_TYPE_CDC_ACM)
 390:USBX/App/ux_device_descriptors.c ****     {
 391:USBX/App/ux_device_descriptors.c ****       pDevDesc->bDeviceClass = 0x02;
 392:USBX/App/ux_device_descriptors.c ****       pDevDesc->bDeviceSubClass = 0x02;
 393:USBX/App/ux_device_descriptors.c ****       pDevDesc->bDeviceProtocol = 0x00;
 394:USBX/App/ux_device_descriptors.c ****     }
 395:USBX/App/ux_device_descriptors.c ****   }
 396:USBX/App/ux_device_descriptors.c **** 
 397:USBX/App/ux_device_descriptors.c ****   return pDevFrameWorkDesc;
 398:USBX/App/ux_device_descriptors.c **** }
 399:USBX/App/ux_device_descriptors.c **** 
 400:USBX/App/ux_device_descriptors.c **** /**
 401:USBX/App/ux_device_descriptors.c ****   * @brief  USBD_FrameWork_AddClass
 402:USBX/App/ux_device_descriptors.c ****   *         Register a class in the class builder
 403:USBX/App/ux_device_descriptors.c ****   * @param  pdev: device instance
 404:USBX/App/ux_device_descriptors.c ****   * @param  pclass: pointer to the class structure to be added
 405:USBX/App/ux_device_descriptors.c ****   * @param  class: type of the class to be added (from USBD_CompositeClassTypeDef)
 406:USBX/App/ux_device_descriptors.c ****   * @param  cfgidx: configuration index
 407:USBX/App/ux_device_descriptors.c ****   * @retval status
 408:USBX/App/ux_device_descriptors.c ****   */
 409:USBX/App/ux_device_descriptors.c **** uint8_t  USBD_FrameWork_AddClass(USBD_DevClassHandleTypeDef *pdev,
 410:USBX/App/ux_device_descriptors.c ****                                  USBD_CompositeClassTypeDef class,
 411:USBX/App/ux_device_descriptors.c ****                                  uint8_t cfgidx, uint8_t Speed,
 412:USBX/App/ux_device_descriptors.c ****                                  uint8_t *pCmpstConfDesc)
 413:USBX/App/ux_device_descriptors.c **** {
 414:USBX/App/ux_device_descriptors.c ****   if ((pdev->classId < USBD_MAX_SUPPORTED_CLASS) &&
 415:USBX/App/ux_device_descriptors.c ****       (pdev->tclasslist[pdev->classId].Active == 0U))
 416:USBX/App/ux_device_descriptors.c ****   {
 417:USBX/App/ux_device_descriptors.c ****     /* Store the class parameters in the global tab */
 418:USBX/App/ux_device_descriptors.c ****     pdev->tclasslist[pdev->classId].ClassId = pdev->classId;
 419:USBX/App/ux_device_descriptors.c ****     pdev->tclasslist[pdev->classId].Active = 1U;
 420:USBX/App/ux_device_descriptors.c ****     pdev->tclasslist[pdev->classId].ClassType = class;
 421:USBX/App/ux_device_descriptors.c **** 
 422:USBX/App/ux_device_descriptors.c ****     /* Call configuration descriptor builder and endpoint configuration builder */
 423:USBX/App/ux_device_descriptors.c ****     if (USBD_FrameWork_AddToConfDesc(pdev, Speed, pCmpstConfDesc) != UX_SUCCESS)
 424:USBX/App/ux_device_descriptors.c ****     {
 425:USBX/App/ux_device_descriptors.c ****       return UX_ERROR;
 426:USBX/App/ux_device_descriptors.c ****     }
 427:USBX/App/ux_device_descriptors.c ****   }
 428:USBX/App/ux_device_descriptors.c **** 
 429:USBX/App/ux_device_descriptors.c ****   UNUSED(cfgidx);
 430:USBX/App/ux_device_descriptors.c **** 
 431:USBX/App/ux_device_descriptors.c ****   return UX_SUCCESS;
 432:USBX/App/ux_device_descriptors.c **** }
 433:USBX/App/ux_device_descriptors.c **** 
 434:USBX/App/ux_device_descriptors.c **** /**
 435:USBX/App/ux_device_descriptors.c ****   * @brief  USBD_FrameWork_AddToConfDesc
 436:USBX/App/ux_device_descriptors.c ****   *         Add a new class to the configuration descriptor
 437:USBX/App/ux_device_descriptors.c ****   * @param  pdev: device instance
 438:USBX/App/ux_device_descriptors.c ****   * @retval status
 439:USBX/App/ux_device_descriptors.c ****   */
 440:USBX/App/ux_device_descriptors.c **** uint8_t  USBD_FrameWork_AddToConfDesc(USBD_DevClassHandleTypeDef *pdev, uint8_t Speed,
 441:USBX/App/ux_device_descriptors.c ****                                       uint8_t *pCmpstConfDesc)
ARM GAS  /tmp/cc95weaH.s 			page 12


 442:USBX/App/ux_device_descriptors.c **** {
 443:USBX/App/ux_device_descriptors.c ****   uint8_t interface = 0U;
 444:USBX/App/ux_device_descriptors.c **** 
