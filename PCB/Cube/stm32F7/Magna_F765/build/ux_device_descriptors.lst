  72:USBX/App/ux_device_descriptors.c **** /* String Device Framework :
  73:USBX/App/ux_device_descriptors.c ****  Byte 0 and 1 : Word containing the language ID : 0x0904 for US
  74:USBX/App/ux_device_descriptors.c ****  Byte 2       : Byte containing the index of the descriptor
  75:USBX/App/ux_device_descriptors.c ****  Byte 3       : Byte containing the length of the descriptor string
  76:USBX/App/ux_device_descriptors.c **** */
  77:USBX/App/ux_device_descriptors.c **** #if defined ( __ICCARM__ ) /* IAR Compiler */
  78:USBX/App/ux_device_descriptors.c **** #pragma data_alignment=4
  79:USBX/App/ux_device_descriptors.c **** #endif /* defined ( __ICCARM__ ) */
  80:USBX/App/ux_device_descriptors.c **** __ALIGN_BEGIN UCHAR USBD_string_framework[USBD_STRING_FRAMEWORK_MAX_LENGTH]
  81:USBX/App/ux_device_descriptors.c **** __ALIGN_END = {0};
  82:USBX/App/ux_device_descriptors.c **** 
  83:USBX/App/ux_device_descriptors.c **** /* Multiple languages are supported on the device, to add
  84:USBX/App/ux_device_descriptors.c ****    a language besides English, the Unicode language code must
  85:USBX/App/ux_device_descriptors.c ****    be appended to the language_id_framework array and the length
  86:USBX/App/ux_device_descriptors.c ****    adjusted accordingly. */
  87:USBX/App/ux_device_descriptors.c **** 
  88:USBX/App/ux_device_descriptors.c **** #if defined ( __ICCARM__ ) /* IAR Compiler */
