 152:Middlewares/ST/threadx/ports/cortex_m7/gnu/inc/tx_port.h **** 
 153:Middlewares/ST/threadx/ports/cortex_m7/gnu/inc/tx_port.h **** /* Define the clock source for trace event entry time stamp. The following two item are port specif
