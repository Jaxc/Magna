  47:Middlewares/ST/filex/common/src/fx_media_close.c **** /*                                                                        */
  48:Middlewares/ST/filex/common/src/fx_media_close.c **** /*    This function examines the list of open files for this media and    */
  49:Middlewares/ST/filex/common/src/fx_media_close.c **** /*    closes each file.  If a file has been written to, the file's        */
  50:Middlewares/ST/filex/common/src/fx_media_close.c **** /*    directory information is also written out to the media.  After      */
  51:Middlewares/ST/filex/common/src/fx_media_close.c **** /*    the files have been closed, the internal logical sector is          */
  52:Middlewares/ST/filex/common/src/fx_media_close.c **** /*    flushed and a flush command is sent to the attached driver.         */
  53:Middlewares/ST/filex/common/src/fx_media_close.c **** /*    Finally, this media control block is removed from the list of       */
  54:Middlewares/ST/filex/common/src/fx_media_close.c **** /*    opened media control blocks and is marked as closed.                */
  55:Middlewares/ST/filex/common/src/fx_media_close.c **** /*                                                                        */
  56:Middlewares/ST/filex/common/src/fx_media_close.c **** /*  INPUT                                                                 */
  57:Middlewares/ST/filex/common/src/fx_media_close.c **** /*                                                                        */
  58:Middlewares/ST/filex/common/src/fx_media_close.c **** /*    media_ptr                             Media control block pointer   */
  59:Middlewares/ST/filex/common/src/fx_media_close.c **** /*                                                                        */
  60:Middlewares/ST/filex/common/src/fx_media_close.c **** /*  OUTPUT                                                                */
  61:Middlewares/ST/filex/common/src/fx_media_close.c **** /*                                                                        */
  62:Middlewares/ST/filex/common/src/fx_media_close.c **** /*    return status                                                       */
  63:Middlewares/ST/filex/common/src/fx_media_close.c **** /*                                                                        */
