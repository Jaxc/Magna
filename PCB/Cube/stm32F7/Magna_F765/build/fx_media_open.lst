  45:Middlewares/ST/filex/common/src/fx_media_open.c **** /*                                                                        */
  46:Middlewares/ST/filex/common/src/fx_media_open.c **** /*    This function opens the specified media with the supplied device    */
  47:Middlewares/ST/filex/common/src/fx_media_open.c **** /*    driver.  The specified media must conform to the FAT compatible     */
  48:Middlewares/ST/filex/common/src/fx_media_open.c **** /*    file format, which is verified during the media open process.  In   */
  49:Middlewares/ST/filex/common/src/fx_media_open.c **** /*    addition, the supplied FileX device driver must also conform to     */
  50:Middlewares/ST/filex/common/src/fx_media_open.c **** /*    the FileX device driver specification.                              */
  51:Middlewares/ST/filex/common/src/fx_media_open.c **** /*                                                                        */
  52:Middlewares/ST/filex/common/src/fx_media_open.c **** /*    The FAT boot sector (512 bytes) that is verified by this            */
  53:Middlewares/ST/filex/common/src/fx_media_open.c **** /*    function must look like the following:                              */
  54:Middlewares/ST/filex/common/src/fx_media_open.c **** /*                                                                        */
  55:Middlewares/ST/filex/common/src/fx_media_open.c **** /*          Byte Offset         Meaning             Size                  */
  56:Middlewares/ST/filex/common/src/fx_media_open.c **** /*                                                                        */
  57:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x000         Jump Instructions        3                    */
  58:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x003         OEM Name                 8                    */
  59:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x00B        *Bytes per Sector         2                    */
  60:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x00D        *Sectors per Cluster      1                    */
  61:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x00E        *Reserved Sectors         2                    */
  62:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x010        *Number of FATs           1                    */
  63:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x011        *Max Root Dir Entries     2                    */
  64:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x013        *Number of Sectors        2                    */
  65:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x015         Media Type               1                    */
  66:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x016        *Sectors per FAT          2                    */
  67:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x018        *Sectors per Track        2                    */
  68:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x01A        *Number of Heads          2                    */
  69:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x01C        *Hidden Sectors           4                    */
  70:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x020        *Huge Sectors             4                    */
  71:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x024         Drive Number             1                    */
  72:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x025         Reserved                 1                    */
