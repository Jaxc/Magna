  74:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x027         Volume ID                4                    */
  75:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x02B         Volume Label             11                   */
  76:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x036         File System Type         8                    */
  77:Middlewares/ST/filex/common/src/fx_media_open.c **** /*             ...              ...                 ...                   */
  78:Middlewares/ST/filex/common/src/fx_media_open.c **** /*            0x1FE       **Signature (0x55aa)       2                    */
