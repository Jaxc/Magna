 119:Middlewares/ST/filex/common/src/fx_file_close.c ****     {
 120:Middlewares/ST/filex/common/src/fx_file_close.c **** 
 121:Middlewares/ST/filex/common/src/fx_file_close.c ****         /* Otherwise, not the only opened file, link-up the neighbors.  */
 122:Middlewares/ST/filex/common/src/fx_file_close.c ****         (file_ptr -> fx_file_opened_next) -> fx_file_opened_previous =
 123:Middlewares/ST/filex/common/src/fx_file_close.c ****             file_ptr -> fx_file_opened_previous;
 124:Middlewares/ST/filex/common/src/fx_file_close.c ****         (file_ptr -> fx_file_opened_previous) -> fx_file_opened_next =
 125:Middlewares/ST/filex/common/src/fx_file_close.c ****             file_ptr -> fx_file_opened_next;
 126:Middlewares/ST/filex/common/src/fx_file_close.c **** 
 127:Middlewares/ST/filex/common/src/fx_file_close.c ****         /* See if we have to update the opened list head pointer.  */
 128:Middlewares/ST/filex/common/src/fx_file_close.c ****         if (media_ptr -> fx_media_opened_file_list == file_ptr)
 129:Middlewares/ST/filex/common/src/fx_file_close.c ****         {
 130:Middlewares/ST/filex/common/src/fx_file_close.c **** 
 131:Middlewares/ST/filex/common/src/fx_file_close.c ****             /* Yes, move the head pointer to the next opened file. */
 132:Middlewares/ST/filex/common/src/fx_file_close.c ****             media_ptr -> fx_media_opened_file_list =  file_ptr -> fx_file_opened_next;
 133:Middlewares/ST/filex/common/src/fx_file_close.c ****         }
 134:Middlewares/ST/filex/common/src/fx_file_close.c ****     }
 135:Middlewares/ST/filex/common/src/fx_file_close.c **** 
 136:Middlewares/ST/filex/common/src/fx_file_close.c ****     /* Decrement the opened file counter.  */
