  61:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*                                                                        */ 
  62:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    This function calculates the sector offset to the specified         */ 
  63:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    partition.  The buffer containing the partition table is also       */ 
  64:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    supplied to this function.  If the buffer supplied is a boot        */ 
  65:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    record (which could be the case in non-partition systems), this     */ 
  66:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    function returns an offset of zero, the total sectors, and a        */ 
  67:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    successful status indicating that the buffer supplied is the boot   */ 
  68:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    record.  Otherwise, if a partition is found, this function returns  */ 
  69:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    the sector offset to its boot record along with a successful        */ 
  70:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    status. If the specified partition is not found or the buffer is    */ 
  71:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    not a partition table or boot record, this function returns an      */ 
  72:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    error.                                                              */ 
  73:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*                                                                        */ 
  74:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    Note: Empty partitions have a FX_SUCCESS return code, however their */ 
  75:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*          starting sector is FX_NULL and the size returned is 0.        */ 
  76:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*                                                                        */ 
  77:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*  INPUT                                                                 */ 
  78:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*                                                                        */ 
  79:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    partition_sector                      Pointer to buffer containing  */ 
  80:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*                                            either the partition table  */ 
  81:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*                                            or the boot sector          */ 
  82:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    partition                             Desired partition             */ 
  83:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    partition_start                       Return partition start        */ 
  84:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*    partition_size                        Return partition size         */ 
  85:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*                                                                        */ 
  86:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*  OUTPUT                                                                */ 
  87:Middlewares/ST/filex/common/src/fx_partition_offset_calculate.c **** /*                                                                        */ 
