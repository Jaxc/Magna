  47:Middlewares/ST/filex/common/src/fx_directory_attributes_read.c **** /*    This function first attempts to find the specified directory.  If   */
  48:Middlewares/ST/filex/common/src/fx_directory_attributes_read.c **** /*    found, the attribute read request is valid and the directory entry  */
  49:Middlewares/ST/filex/common/src/fx_directory_attributes_read.c **** /*    will be read in order to pickup the directory's attributes.         */
  50:Middlewares/ST/filex/common/src/fx_directory_attributes_read.c **** /*    Otherwise, if the directory is not found, the appropriate error     */
  51:Middlewares/ST/filex/common/src/fx_directory_attributes_read.c **** /*    code is returned to the caller.                                     */
  52:Middlewares/ST/filex/common/src/fx_directory_attributes_read.c **** /*                                                                        */
