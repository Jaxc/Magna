 712:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****     This subsection provides a set of functions allowing to manage the I2S data
 713:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****     transfers.
 714:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c **** 
 715:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****     (#) There are two modes of transfer:
ARM GAS  /tmp/ccr2nkT0.s 			page 14


 716:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****        (++) Blocking mode : The communication is performed in the polling mode.
 717:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****             The status of all data processing is returned by the same function
 718:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****             after finishing transfer.
 719:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****        (++) No-Blocking mode : The communication is performed using Interrupts
 720:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****             or DMA. These functions return the status of the transfer startup.
 721:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****             The end of the data processing will be indicated through the
 722:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****             dedicated I2S IRQ when using Interrupt mode or the DMA IRQ when
 723:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****             using DMA mode.
 724:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c **** 
 725:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****     (#) Blocking mode functions are :
 726:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****         (++) HAL_I2S_Transmit()
 727:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****         (++) HAL_I2S_Receive()
 728:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c **** 
 729:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****     (#) No-Blocking mode functions with Interrupt are :
 730:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****         (++) HAL_I2S_Transmit_IT()
 731:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****         (++) HAL_I2S_Receive_IT()
 732:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c **** 
 733:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****     (#) No-Blocking mode functions with DMA are :
 734:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****         (++) HAL_I2S_Transmit_DMA()
 735:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****         (++) HAL_I2S_Receive_DMA()
 736:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c **** 
 737:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****     (#) A set of Transfer Complete Callbacks are provided in non Blocking mode:
 738:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****         (++) HAL_I2S_TxCpltCallback()
 739:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****         (++) HAL_I2S_RxCpltCallback()
 740:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c ****         (++) HAL_I2S_ErrorCallback()
 741:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c **** 
 742:Drivers/STM32F7xx_HAL_Driver/Src/stm32f7xx_hal_i2s.c **** @endverbatim
