  45:Middlewares/ST/usbx/common/usbx_host_classes/src/ux_host_class_storage_media_mount.c **** /*    This function tries to read the first sector on the media. It then  */
  46:Middlewares/ST/usbx/common/usbx_host_classes/src/ux_host_class_storage_media_mount.c **** /*    determines if this is a partition sector or a boot sector. If the   */
  47:Middlewares/ST/usbx/common/usbx_host_classes/src/ux_host_class_storage_media_mount.c **** /*    sector contains partition information, each partition is checked    */
  48:Middlewares/ST/usbx/common/usbx_host_classes/src/ux_host_class_storage_media_mount.c **** /*    for a DOS aware partition and mounted by UX_MEDIA (default FileX).  */
  49:Middlewares/ST/usbx/common/usbx_host_classes/src/ux_host_class_storage_media_mount.c **** /*                                                                        */
  50:Middlewares/ST/usbx/common/usbx_host_classes/src/ux_host_class_storage_media_mount.c **** /*    If there is no partition sector or boot sector, we simply inform    */
  51:Middlewares/ST/usbx/common/usbx_host_classes/src/ux_host_class_storage_media_mount.c **** /*    UX_MEDIA (default FileX) that a device is present and that its boot */
  52:Middlewares/ST/usbx/common/usbx_host_classes/src/ux_host_class_storage_media_mount.c **** /*    sector  should be periodically read to see if the device is mounted.*/
  53:Middlewares/ST/usbx/common/usbx_host_classes/src/ux_host_class_storage_media_mount.c **** /*    This mechanism applies to storage where the media can be removed    */
